# Flask Application Secret Key (Generate a random 32+ character hex string)
FLASK_SECRET_KEY=generate_a_random_secret_hex_key_here

# SMTP Email Configuration (Required for Magic Link delivery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_16_char_app_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# Optional Port (Hosting platforms usually supply this automatically via $PORT)
PORT=5001
